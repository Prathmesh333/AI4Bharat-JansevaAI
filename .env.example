AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=your-account-id

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here

# DynamoDB
SESSION_TABLE_NAME=janseva-sessions
USER_PROFILE_TABLE_NAME=janseva-user-profiles

# S3
SCHEME_DOCUMENTS_BUCKET=janseva-scheme-docs
FORMS_BUCKET=janseva-forms

# OpenSearch
OPENSEARCH_ENDPOINT=your-opensearch-endpoint
OPENSEARCH_INDEX=janseva-schemes

# Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REGION=us-east-1

# API
API_STAGE=dev
