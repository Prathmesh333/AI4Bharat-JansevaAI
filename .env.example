AWS_REGION=ap-south-1
PORT=3000

# Optional: restrict cross-origin API access when frontend and API are on different origins.
# Comma-separated list, for example:
# CORS_ORIGINS=https://janseva.example.com,https://staging.janseva.example.com
CORS_ORIGINS=

# Required for live chat / AI-generated guidance
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: enables richer CSC lookup results through Google Places
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Optional: persist saved forms in S3 for AWS/App Runner.
# If omitted, the app falls back to local JSON storage.
FORMS_BUCKET=your-forms-bucket-name
SAVED_FORMS_KEY=saved-forms/forms.json
